<div class="form-page">
  <div class="form-card">
    <div class="form-back">
      <%= link_to "← 授業管理へ戻る", courses_path %>
    </div>

    <h2 class="form-title">授業の情報を編集</h2>

    <%= form_with model: @course, local: true do |f| %>
      <%= render 'shared/error_messages', model: f.object %>

      <div class="field">
        <%= f.label :name, "授業名" %>
        <%= f.text_field :name, autofocus: true %>
      </div>

      <div class="field">
        <%= f.label :grade, "学年" %>
        <%= f.select :grade, [["1年", 1], ["2年", 2], ["3年", 3]] %>
      </div>

      <div class="field">
        <%= f.label :subject_id, "教科" %>
        <%= f.collection_select :subject_id, @subjects, :id, :name %>
      </div>

      <div class="field">
        <%= f.label :academic_year_id, "年度" %>
        <%= f.collection_select :academic_year_id, @academic_years, :id, :year %>
      </div>

      <div class="actions">
        <%= f.submit "更新" %>
      </div>
    <% end %>
  </div>
</div>