<div class="form-page">
  <div class="form-card">
    <div class="form-back">
      <%= link_to "← ユーザー管理へ戻る", users_path %>
    </div>

    <h2 class="form-title">ユーザー情報を編集</h2>

    <%= form_with model: @user, local: true do |f| %>
      <%= render 'shared/error_messages', model: f.object %>

      <div class="field">
        <%= f.label :name, "ユーザー名" %>
        <%= f.text_field :name, autofocus: true %>
      </div>

      <div class="field">
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email, autocomplete: "email" %>
      </div>

      <div class="field">
        <%= f.label :password, "新しいパスワード" %>
        <%= f.password_field :password, autocomplete: "new-password" %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "新しいパスワード確認" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>

      <% if current_user.system_admin? %>
        <div class="field">
          <%= f.label :role, "管理権限" %>
          <%= f.select :role, [["一般", "user"], ["管理者", "system_admin"]] %>
        </div>

        <div class="field">
          <%= f.label :subject_ids, "担当教科" %>

          <%= f.collection_check_boxes :subject_ids, @subjects, :id, :name do |b| %>
            <div class="subject-checkbox">
              <%= b.check_box %>
              <%= b.label %>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="actions">
        <%= f.submit "更新" %>
      </div>
    <% end %>
  </div>
</div>